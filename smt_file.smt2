(set-logic AUFNIRA)
(declare-fun Ap (Int) Int)
(assert ( forall ((x1 Int) (x2 Int)) (=> (> x2 x1) (>= (Ap x2) (Ap x1))) ))
(declare-fun Ai (Int) Int)
(assert ( forall ((x1 Int) (x2 Int)) (=> (> x2 (Ap x1)) (> (Ai x2) x1)) ))
(declare-const i1 Int)
(declare-const n Int)
(assert (and (>= i1 0) (< i1 n)))
(declare-const i2 Int)
(assert (and (>= i2 0) (< i2 n)))
(declare-const j1 Int)
(assert (and (>= j1 (+ 1 (Ap i1))) (< j1 (Ap (+ 1 i1)))))
(declare-const j2 Int)
(assert (and (>= j2 (+ 1 (Ap i2))) (< j2 (Ap (+ 1 i2)))))
(assert (and (> i2 i1) (= (Ai j1) i2)))
