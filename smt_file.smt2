(set-logic AUFNIRA)
(declare-fun Ap (Int) Int)
(assert ( forall ((x1 Int) (x2 Int)) (=> (> x2 x1) (>= (Ap x2) (Ap x1))) ))
(declare-fun Ai (Int) Int)
(assert ( forall ((x1 Int) (x2 Int)) (= (> x2 (Ap x1)) (> (Ai x2) x1)) ))
(declare-const i Int)
(declare-const n Int)
(assert (and (<= i n) (> i 0)))
(declare-const j Int)
(assert (and (<= j (Ap (+ 1 i))) (> j (+ 1 (Ap i)))))
(assert (and (> i i) (= (Ai j) i)))
