(set-logic AUFNIRA)
(declare-fun Ap (Int) Int)
(assert ( forall ((x1 Int) (x2 Int)) (=> (> x2 x1) (>= (Ap x2) (Ap x1))) ))
(declare-fun Ai (Int) Int)
(declare-const i1 Int)
(declare-const n Int)
(assert (and (<= i1 n) (> i1 0)))
(declare-const i2 Int)
(assert (and (<= i2 n) (> i2 0)))
(declare-const k_ptr1 Int)
(assert (and (> k_ptr1 (Ap i1)) (<= k_ptr1 (Ap (+ 1 i1)))))
(declare-const k_ptr2 Int)
(assert (and (> k_ptr2 (Ap i2)) (<= k_ptr2 (Ap (+ 1 i2)))))
(assert (and (> i1 0) (> i2 0) (> i2 i1) (< i1 n) (< i2 n) (= i1 (Ai k_ptr2)) (> k_ptr2 (Ap i2)) (< (Ai k_ptr2) i2) (< k_ptr2 (Ap (+ 1 i2)))))
