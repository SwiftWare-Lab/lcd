(set-logic AUFNIRA)
(declare-fun Ap (Int) Int)
(assert ( forall ((x1 Int) (x2 Int)) (=> (> x2 x1) (>= (Ap x2) (Ap x1))) ))
(declare-fun Ai (Int) Int)
(declare-const i1 Int)
(declare-const m Int)
(assert (and (<= i1 m) (> i1 0)))
(declare-const i2 Int)
(declare-const n Int)
(assert (and (<= i2 n) (> i2 0)))
(declare-const i3 Int)
(assert (and (<= i3 n) (> i3 0)))
(declare-const j1 Int)
(assert (and (<= j1 m) (> j1 0)))
(declare-const j2 Int)
(assert (and (> j2 (Ap j1)) (<= j2 (Ap (+ 1 j1)))))
(declare-const j3 Int)
(assert (and (<= j3 n) (> j3 0)))
(assert (and (= i3 j3) (> i1 j1) (= i1 (Ai j2))))
