(set-logic AUFNIRA)
(declare-fun A_indptr (Int) Int)
(declare-fun A_indices (Int) Int)
(declare-const k1 Int)
(declare-const n Int)
(assert (and (>= k1 0) (<= k1 n)))
(declare-const k2 Int)
(assert (and (>= k2 0) (<= k2 n)))
(declare-const dptr1 Int)
(assert (and (>= dptr1 (A_indptr k1)) (<= dptr1 (A_indptr (+ 1 k1)))))
(declare-const dptr2 Int)
(assert (and (>= dptr2 (A_indptr k2)) (<= dptr2 (A_indptr (+ 1 k2)))))
(declare-const i_ptr1 Int)
(assert (and (>= i_ptr1 (A_indptr k1)) (<= i_ptr1 (A_indptr (+ 1 k1)))))
(declare-const i_ptr2 Int)
(assert (and (>= i_ptr2 (A_indptr k2)) (<= i_ptr2 (A_indptr (+ 1 k2)))))
(declare-const j1 Int)
(assert (and (<= j1 n) (>= j1 (+ 1 k1))))
(declare-const j2 Int)
(assert (and (<= j2 n) (>= j2 (+ 1 k2))))
(declare-const kj_ptr1 Int)
(assert (and (>= kj_ptr1 (A_indptr j1)) (<= kj_ptr1 (A_indptr (+ 1 j1)))))
(declare-const kj_ptr2 Int)
(assert (and (>= kj_ptr2 (A_indptr j2)) (<= kj_ptr2 (A_indptr (+ 1 j2)))))
(declare-const ij_ptr1 Int)
(assert (and (>= ij_ptr1 (A_indptr j1)) (<= ij_ptr1 (A_indptr (+ 1 j1)))))
(declare-const ij_ptr2 Int)
(assert (and (>= ij_ptr2 (A_indptr j2)) (<= ij_ptr2 (A_indptr (+ 1 j2)))))
(assert ( forall ((x1 Int) (x2 Int)) (=> (> x2 x1) (>= (A_indptr x2) (A_indptr x1))) ))
(assert (forall ((segment Int) (p Int) (q Int)) (=> (and (<= 0 segment) (< segment n) (<= (A_indptr segment) p) (< p q) (< q (A_indptr (+ segment 1)))) (<= (A_indices p) (A_indices q)))))
(declare-const diag_val Real)
(declare-const u_kj Real)
(assert (and (>= k1 0) (< k1 n) (>= i_ptr1 (A_indptr k1)) (< i_ptr1 (A_indptr (+ 1 k1))) (not (<= (A_indices i_ptr1) k1)) (not (= diag_val 0.0)) (>= k2 0) (< k2 n) (>= i_ptr2 (A_indptr k2)) (< i_ptr2 (A_indptr (+ 1 k2))) (>= j2 (+ 1 k2)) (< j2 n) (>= ij_ptr2 (A_indptr j2)) (< ij_ptr2 (A_indptr (+ 1 j2))) (= (A_indices ij_ptr2) (A_indices i_ptr2)) (forall ((ij_ptr_prev2 Int)) (=> (and (>= ij_ptr_prev2 (A_indptr j2)) (> ij_ptr2 ij_ptr_prev2)) (not (= (A_indices ij_ptr_prev2) (A_indices i_ptr2))))) (not (= u_kj 0.0)) (not (<= (A_indices i_ptr2) k2)) (not (= diag_val 0.0)) (= i_ptr1 ij_ptr2) (> k2 k1)))
